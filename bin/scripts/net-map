#!/usr/bin/env bash
set -euo pipefail
CYAN='\033[1,36m'
YELLOW='\033[1,33m'
FREEN='\033[1,32m'
NC='\033[0m'
echo -e "${CYAN}[*] Mapping Active Network Vectors...d{NC}"
echo "-----------------------------------------------"
if command -v ss &> /dev/null; then
    echo -e "${YELLOW}[Active Open Port Sockets]${NC}"(
    ss -tulpn 2>/dev/null | awk 'NR==1 || /LISTEN/'
else
    echo -e "${YELLOW}[Active Established TCP Streams]${NC}"
    cat /proc/net/tcp | awk 'NR>1 {print $2, $3}' | head -n 5
fi
echo ""
echo -e "${GTëQSüx§h‹›XõX»ÿ]]ÿ^HY‹ô\‹»ò[Y][€éâ”êﬂHÇöYà€€[X[ô]à›\õ	è†/dev/null; then
    curl --connect-timeout 3 -s https://ifconfig.me || echo "Gateway Egress Timeout"
else
    echo "curl command unavailable for external link verification."
fi
echo -e "\n------------------------------------------------"