#!/usr/bin/env python3
"""
parallel_hash - Multiprocess SHA-256 calculator for ez_jukebox.
Optimized for Crostini multi-core performance.
"""
import hashlib
import os
import sys
from concurrent.futures import ProcessPoolExecutor, as_completed
from pathlib import Path
from typing import NamedTuple

CHUNK_SIZE = 128 * 1024  # 128KB chunks for optimal disk throughput


class HashResult(NamedTuple):
    path: str
    sha256: str
    error: str | None


def compute_hash(file_path: Path) -> HashResult:
    """Calculate the SHA-256 hash of a single file in chunks."""
    hasher = hashlib.sha256()
    try:
        with open(file_path, "rb") as f:
            while chunk := f.read(CHUNK_SIZE):
                hasher.update(chunk)
        return HashResult(str(file_path), hasher.hexdigest(), None)
    except Exception as exc:
        return HashResult(str(file_path), "", str(exc))


def hash_directory(target_dir: str | Path) -> list[HashResult]:
    """Scan a directory and parallelize file hashing across available CPU cores."""
    base_path = Path(target_dir).resolve()
    files = [p for p in base_path.rglob("*") if p.is_file()]
    
    cpu_cores = os.cpu_count() or 1
    print(f"\033[1;36m[*] Found {len(files)} files. Hashing across {cpu_cores} CPU cores...\033[0m")
    
    results: list[HashResult] = []
    with ProcessPoolExecutor(max_workers=cpu_cores) as executor:
        futures = {executor.submit(compute_hash, p): p for p in files}
        for future in as_completed(futures):
            res = future.result()
            results.append(res)
            if res.error:
                print(f"\033[1;31m[!] Error reading {res.path}: {res.error}\033[0m", file=sys.stderr)

    return results


if __name__ == "__main__":
    target = sys.argv[1] if len(sys.argv) > 1 else "."
    hashed_files = hash_directory(target)
    print(f"\033[1;32m[✔] Processed {len(hashed_files)} files successfully.\033[0m")
